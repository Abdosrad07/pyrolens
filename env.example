# PyroLens — gabarit d'environnement (AUCUNE valeur secrète)
# Copier vers `.env.local` : `cp env.example .env.local` (puis renseigner),
# ou renseigner dans Settings → Environment.
# Convention : `.env.local` écrase `.env`. Ne jamais committer de clé remplie.
#
# Les clés d'acquisition ci-dessous ne sont lues que par le PIPELINE Python
# (`pyrolens download`) : l'API (`api/`) ne lit JAMAIS `FIRMS_MAP_KEY` ni `EARTHDATA_*`.

# ── Acquisition (pipeline, locales) ─────────────────────────────────────────
FIRMS_MAP_KEY=
EARTHDATA_USER=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=

# ── API FastAPI (`api/`, voir docs/api.md) ──────────────────────────────────
# Si défini, les endpoints POST exigent « Authorization: Bearer <jeton> ».
PYROLENS_API_TOKEN=
# Origines CORS autorisées, séparées par des virgules (vide = aucune).
PYROLENS_CORS_ORIGINS=
# Répertoires (chemins relatifs à la racine du projet ou absolus).
PYROLENS_ARTIFACTS_DIR=web/public/artifacts
PYROLENS_EXPERIMENTS_DIR=reports/experiments
# Écrase le choix automatique de la source (data/raw/firms s'il contient des
# CSV, sinon data/fixture). Laisser vide en général.
PYROLENS_SOURCE_DIR=
# Comportement (défauts entre parenthèses).
PYROLENS_CACHE_TTL_SECONDS=30
PYROLENS_MAX_UPLOAD_BYTES=10485760
PYROLENS_JOBS_ENABLED=true
PYROLENS_MAX_JOBS=20

# ── Exécution du serveur ────────────────────────────────────────────────────
# PORT est injecté par la plateforme (Freebuff) ; le définir uniquement en local.
PORT=8000
