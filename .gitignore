# ── Secrets et environnements (jamais versionnés) ──
.env
.env.*
!.env.example

# ── Python ──
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / Vite ──
node_modules/
web/dist/
web/.vite/

# ── Données d'acquisition volumineuses (reproductibles via `pyrolens download`) ──
data/raw/firms/
data/raw/earthdata/
data/raw/archive/
models/

# ── Sorties d'exécution régénérables (pas des artefacts publiés) ──
reports/anomalies/
reports/experiments/
reports/logs/
*.log

# ── Éditeurs / système ──
.DS_Store
.idea/
.vscode/
*.swp

# ── Archive d'export locale (contenu déjà versionné ; trop lourde pour Git) ──
pyrolens-github.zip
