      "get": {
        "tags": [
          "expériences"
        ],
        "summary": "Lister les expériences",
        "description": "Tâches connues du processus courant (plus les résultats persistés des tâches terminées).",
        "operationId": "list_experiments_api_v1_experiments_get",
