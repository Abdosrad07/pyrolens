              ],
              "description": "terra__aqua | aqua__viirs_snpp",
              "title": "Pair"
            },
            "description": "terra__aqua | aqua__viirs_snpp"
          },
          {
            "name": "grid_deg",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "0.1 | 0.25 | 0.5",
              "title": "Grid Deg"
            },
            "description": "0.1 | 0.25 | 0.5"
          },
          {
            "name": "window_days",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "1 | 4 | 8 | 16",
              "title": "Window Days"
            },
            "description": "1 | 4 | 8 | 16"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "$ref": "#/components/schemas/RowsResponse"
