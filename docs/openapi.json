        "title": "Body_validate_dataset_api_v1_datasets_validate_post"
      },
      "ExperimentRequest": {
        "properties": {
          "pair": {
            "type": "string",
            "title": "Pair",
            "description": "Paire de capteurs : terra__aqua | aqua__viirs_snpp."
          },
          "grid_deg": {
            "type": "number",
            "title": "Grid Deg",
            "description": "Maille en degrés : 0.1 | 0.25 | 0.5 (valeurs de la configuration)."
          },
          "window_days": {
            "type": "integer",
            "maximum": 365.0,
