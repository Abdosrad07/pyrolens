    "schemas": {
      "Body_validate_dataset_api_v1_datasets_validate_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "CSV FIRMS (UTF-8)"
