{
  "openapi": "3.1.0",
  "info": {
    "title": "PyroLens API",
    "description": "API de lecture des artefacts PyroLens et d'exécution des expériences d'harmonisation.\n\n* **Source de vérité** : le pipeline Python (`pyrolens`) écrit des artefacts horodatés ;\n  cette API les sert en lecture seule et exécute les expériences demandées dans un\n  thread séparé (aucun calcul scientifique n'est fait « à la va-vite » dans une requête).\n* **Intégrité** : aucun état n'affirme une absence de feu ; les valeurs manquantes ne\n  sont jamais converties ; chaque résultat porte sa provenance (paramètres, versions,\n  empreinte de la source, horodatage).\n* **Contrat** : `docs/api.md` (exemples curl + champs) ; contrat de référence dans\n  `docs/openapi.json` (exporté depuis `/api/v1/openapi.json`).",
    "version": "0.2.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Santé du service",
        "description": "Réponse immédiate sans lecture d'artefact : statut, horodatage de synchronisation et version.",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Métadonnées de l'étude",
        "description": "Période, configuration primaire, grilles, fenêtres, paires publiées et état de l'observabilité.",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json; charset=utf-8": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Meta Api V1 Meta Get"
                }
              }
            }
          }
        }
      }
    },
