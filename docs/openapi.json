    "/api/v1/datasets/validate": {
      "post": {
        "tags": [
          "validation"
        ],
        "summary": "Valider un CSV FIRMS téléversé",
        "description": "Audit en mémoire d'un fichier CSV FIRMS (aucune intégration, aucune correction). Colonnes obligatoires : latitude, longitude, acq_date, acq_time, satellite. Taille maximale : PYROLENS_MAX_UPLOAD_BYTES (10 Mo par défaut).",
        "operationId": "validate_dataset_api_v1_datasets_validate_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_validate_dataset_api_v1_datasets_validate_post"
              }
            }
          },
          "required": true
        },
        "responses": {
